{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022"],
		"types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"paths": {
			"@app/*": ["./app/*"],
			"@congressional-balance-module/*": ["./app/api-modules/congressional-balance-module/*"],
			"@representatives-module/*": ["./app/api-modules/representatives-module/*"],
			"@approval-module/*": ["./app/api-modules/approval-module/*"],
			"@health-check-module/*": ["./app/api-modules/health-check-module/*"],
			"@shared-module/*": ["./app/api-modules/shared-module/*"]
		}
	},
	"include": ["app/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
	"exclude": ["node_modules"]
}
